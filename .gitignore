node_modules/
dist/
coverage/
*.tsbuildinfo

# Run artifacts land in the OS state dir (env-paths), never in the repo. A local override
# via BRAZE_RUNS_DIR pointing here would otherwise commit customer identifiers.
#
# Anchored to the repository root on purpose. Unanchored, `runs/` matches at every depth, and
# it silently swallowed packages/cli/src/runs/ — Phase 1 source that then never reached CI
# (BUG-3). Keep the leading slash.
/runs/
*.log

.DS_Store
.env
.env.*
!.env.example

# Plans, the session journal, the handoff and the cleanup list: the working trail, kept on
# the machine doing the work. Everything that explains what this is and how it is built stays
# in docs/ and is committed.
/docs_ai/

# Per-machine Claude Code state; the shared settings.json is committed.
.claude/settings.local.json
.claude/worktrees/
