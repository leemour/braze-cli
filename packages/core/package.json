{
  "name": "brazecli-core",
  "version": "0.1.0",
  "description": "Runtime-neutral Braze REST client and operation catalog. Web Platform APIs only \u2014 no Node.",
  "license": "MIT",
  "author": "Viacheslav Ptsarev",
  "homepage": "https://github.com/leemour/brazecli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leemour/brazecli.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/leemour/brazecli/issues"
  },
  "keywords": [
    "braze",
    "braze-api",
    "cloudflare-workers",
    "edge",
    "rest-client"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "p-queue": "^9.0.0",
    "valibot": "^1.1.0"
  }
}
